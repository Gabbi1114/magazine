# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_bucket_name

# Public CDN domain for serving files
# Use the R2 public URL or a custom domain connected to the bucket
# e.g. https://pub-xxxx.r2.dev  OR  https://cdn.yourdomain.com
CDN_URL=https://pub-xxxx.r2.dev

# Allowed frontend origin(s) — comma-separated for multiple
FRONTEND_URL=https://your-site.pages.dev

# Port — Render sets this automatically, leave as-is
PORT=3001
